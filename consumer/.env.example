APP_NAME=analogdb-consumer
APP_VERSION=0.1.0
APP_ENV=dev

KAFKA_BROKERS=kafka:29092 # docker
KAFKA_TOPIC=http-requests
KAFKA_CONSUMER_GROUP=analytics-consumer
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT=10s

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=password
CLICKHOUSE_TABLE=httprequests
CLICKHOUSE_MIGRATION_ENABLED=true
CLICKHOUSE_MIGRATION_PATH=

SERVER_PORT=8080

LOG_LEVEL=info
LOG_ENV=prod

METRICS_ENABLED=true
METRICS_PORT=9090
